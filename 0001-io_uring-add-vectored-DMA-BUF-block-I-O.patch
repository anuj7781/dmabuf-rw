 }
 
+static void iov_iter_dmabuf_vec_advance(struct iov_iter *i, size_t size)
+{
+	if (!i->count)
+		return;
+
+	while (size && i->nr_segs) {
+		const struct dma_buf_io_vec *vec = i->dmabuf_vec;
+		size_t len = vec->len - i->iov_offset;
+
+		if (size < len) {
+			i->iov_offset += size;
+			i->count -= size;
+			return;
+		}
+
+		size -= len;
+		i->count -= len;
+		i->dmabuf_vec++;
+		i->nr_segs--;
+		i->iov_offset = 0;
+	}
+}
+
 static void iov_iter_iovec_advance(struct iov_iter *i, size_t size)
 {
 	const struct iovec *iov, *end;
@@ -575,8 +599,10 @@ void iov_iter_advance(struct iov_iter *i, size_t size)
 {
 	if (unlikely(i->count < size))
 		size = i->count;
-	if (likely(iter_is_ubuf(i)) || unlikely(iov_iter_is_xarray(i)) ||
-	    unlikely(iov_iter_is_dmabuf_map(i))) {
+	if (unlikely(iov_iter_is_dmabuf_vec(i))) {
+		iov_iter_dmabuf_vec_advance(i, size);
+	} else if (likely(iter_is_ubuf(i)) || unlikely(iov_iter_is_xarray(i)) ||
+		   unlikely(iov_iter_is_dmabuf_map(i))) {
 		i->iov_offset += size;
 		i->count -= size;
 	} else if (likely(iter_is_iovec(i) || iov_iter_is_kvec(i))) {
@@ -679,6 +705,8 @@ size_t iov_iter_single_seg_count(const struct iov_iter *i)
 			return min(i->count, iter_iov(i)->iov_len - i->iov_offset);
 		if (iov_iter_is_bvec(i))
 			return min(i->count, i->bvec->bv_len - i->iov_offset);
+		if (iov_iter_is_dmabuf_vec(i))
+			return min(i->count, i->dmabuf_vec->len - i->iov_offset);
 	}
 	if (unlikely(iov_iter_is_folioq(i)))
 		return !i->count ? 0 :
@@ -791,6 +819,22 @@ void iov_iter_dmabuf_map(struct iov_iter *i, unsigned int direction,
 	};
 }
 
+void iov_iter_dmabuf_map_vec(struct iov_iter *i, unsigned int direction,
+			const struct dma_buf_io_vec *vec, unsigned int nr_vecs,
+			size_t count)
+{
+	WARN_ON(direction & ~(READ | WRITE));
+	*i = (struct iov_iter){
+		.iter_type = ITER_DMABUF_MAP,
+		.data_source = direction,
+		.is_dmabuf_vec = true,
+		.dmabuf_vec = vec,
+		.nr_segs = nr_vecs,
+		.count = count,
+	};
+}
+EXPORT_SYMBOL(iov_iter_dmabuf_map_vec);
+
