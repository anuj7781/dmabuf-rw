+
+static int io_dmabuf_vec_size(struct iovec *iov, unsigned int nr_iovs,
+				      struct io_regbuf_dma *db, size_t *total_len)
+{
+	unsigned int i;
+
+	*total_len = 0;
+	for (i = 0; i < nr_iovs; i++) {
+		u64 offset = (u64)(uintptr_t)iov[i].iov_base;
+		size_t len = iov[i].iov_len;
 
-	map = dma_buf_io_get_map(&db->ctx);
-	if (unlikely(!map)) {
-		if (!(issue_flags & IO_URING_F_IOWQ))
-			return -EAGAIN;
-		map = dma_buf_io_create_map(&db->ctx);
-		if (IS_ERR(map))
-			return PTR_ERR(map);
+		if (unlikely(!len))
+			return -EFAULT;
+		if (offset > db->ctx.dmabuf->size ||
+		    len > db->ctx.dmabuf->size - offset)
+			return -EFAULT;
+		if (check_add_overflow(*total_len, len, total_len))
+			return -EOVERFLOW;
 	}
+	if (*total_len > MAX_RW_COUNT)
+		return -EINVAL;
+	return 0;
+}
 
-	req->dmabuf_map = map;
-	req->flags |= REQ_F_DROP_DMABUF;
-init_iter:
-	iov_iter_dmabuf_map(iter, ddir, map, offset, len);
+static int io_import_dmabuf_vec(struct io_kiocb *req,
+				int ddir, struct iov_iter *iter,
+				struct io_mapped_ubuf *imu,
+				struct iovec *iov, unsigned int nr_iovs,
+				unsigned int issue_flags)
+{
+	struct io_async_rw *io = req->async_data;
+	struct io_regbuf_dma *db = imu->priv;
+	struct dma_buf_io_map *map;
+	struct dma_buf_io_vec *vec;
+	size_t total_len;
+	unsigned int i;
+	bool new_map = !(req->flags & REQ_F_DROP_DMABUF);
+	int ret;
+
+	ret = io_dmabuf_vec_size(iov, nr_iovs, db, &total_len);
+	if (ret)
+		return ret;
+	if (req->file != db->target_file)
+		return -EBADF;
+	if (!nr_iovs) {
+		iov_iter_bvec(iter, ddir, NULL, 0, 0);
+		return 0;
+	}
+
+	if (new_map) {
+		map = dma_buf_io_get_map(&db->ctx);
+		if (unlikely(!map)) {
+			if (!(issue_flags & IO_URING_F_IOWQ))
+				return -EAGAIN;
+			map = dma_buf_io_create_map(&db->ctx);
+			if (IS_ERR(map))
+				return PTR_ERR(map);
+		}
+		req->dmabuf_map = map;
+		req->flags |= REQ_F_DROP_DMABUF;
+	} else {
+		map = req->dmabuf_map;
+	}
+
+	vec = kcalloc(nr_iovs, sizeof(*vec), GFP_KERNEL);
+	if (!vec) {
+		if (new_map) {
+			dma_buf_io_map_drop(map);
+			req->dmabuf_map = NULL;
+			req->flags &= ~REQ_F_DROP_DMABUF;
+		}
+		return -ENOMEM;
+	}
+
+	for (i = 0; i < nr_iovs; i++) {
+		vec[i] = (struct dma_buf_io_vec) {
+			.map = map,
+			.offset = (u64)(uintptr_t)iov[i].iov_base,
+			.len = iov[i].iov_len,
+		};
+	}
+
+	kfree(io->dmabuf_vec);
+	io->dmabuf_vec = vec;
+	iov_iter_dmabuf_map_vec(iter, ddir, vec, nr_iovs, total_len);
 	return 0;
 }
 
@@ -1857,7 +1942,10 @@ int __io_import_reg_vec(int ddir, struct iov_iter *iter,
 	iov = vec->iovec + iovec_off;
 
 	if (imu->flags & IO_REGBUF_F_DMABUF) {
-		return -EOPNOTSUPP;
+		if (!(import_flags & IO_REGBUF_IMPORT_ALLOW_DMABUF_VEC))
+			return -EOPNOTSUPP;
+		return io_import_dmabuf_vec(req, ddir, iter, imu, iov,
+				nr_iovs, issue_flags);
 	} else if (imu->flags & IO_REGBUF_F_KBUF) {
 		int ret = io_kern_bvec_size(iov, nr_iovs, imu, &nr_segs);
 
