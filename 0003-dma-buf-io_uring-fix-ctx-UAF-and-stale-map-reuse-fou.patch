From 09704bb3bd95669f8657e4309080e42fc4867baf Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj1072538@gmail.com>
Date: Tue, 8 Sep 2026 16:03:23 +0530
Subject: [PATCH 3/3] dma-buf, io_uring: fix ctx UAF and stale-map reuse found
 in review

Two P1-severity issues found by an independent review of the previous
commit, plus two smaller leaks found while fixing the first.

1. ctx use-after-free in the fenced release path

   dma_buf_io_map_active_release() (the map->active percpu_ref release
   callback) signals the drain fence directly, then queues
   dma_buf_io_map_release_work(). That worker was taking a protective
   refcount_inc(&ctx->refs) immediately before doing the actual unmap
   -- but only once a workqueue thread got around to running it.
   dma_buf_io_ctx_release_work() waits on dma_resv_wait_timeout() for
   exactly the fence signal, which happens strictly before the worker
   is even scheduled, let alone running its protective increment. The
   waiter could observe the signal, drop ctx's reference, and free ctx
   before the worker ever touched it, leaving the worker to dereference
   map->ctx and ctx->dmabuf on freed memory.

   v5 avoided this because its equivalent increment and signal were in
   the same function, in that order -- inc, then signal -- so no waiter
   could ever observe the signal first. Moving the signal into the
   percpu_ref callback (to get it off the workqueue/task-work
   dependency chain) broke that ordering guarantee without carrying the
   increment's timing requirement along with it.

   Fix: give the map its own persistent ctx reference, taken
   unconditionally in dma_buf_io_init_map() and dropped only once
   unmap has actually completed, on whichever of the two release paths
   runs (the fenced worker, or the synchronous-drain fallback in
   dma_buf_io_drop_map()). ctx's liveness no longer depends on when the
   worker happens to run relative to the signal.

   The synchronous-drain fallback runs with dma_resv already held
   (dma_buf_io_drop_map()'s own contract), and ctx->dev_ops->release()
   -> dma_buf_detach() takes dma_resv_lock() internally
   (drivers/dma-buf/dma-buf.c), so that branch's pin-drop must defer
   ctx destruction via queue_work() rather than call it inline, exactly
   as the fenced worker already does after unlocking.

2. stale map reuse on io_uring reissue

   io_import_dmabuf() and io_import_dmabuf_vec() both have a fast path
   for a request that already imported a map (REQ_F_DROP_DMABUF set)
   that reused req->dmabuf_map unconditionally. io_uring's reissue
   mechanism re-queues the same req without clearing that flag or
   dropping the map reference, so a request reissued after its
   generation was invalidated would silently retry against the dead
   map. Not a use-after-free -- the request's own kref keeps the
   struct's memory allocated regardless of ->active state -- but the
   retry would spuriously fail active acquisition at the driver instead
   of importing the current generation.

   Fix: check the retained map against ctx->map before reusing it.
   Plain pointer comparison via rcu_access_pointer() is sufficient --
   the caller already holds a live kref on its own map, so the compared
   address cannot have been recycled for a different generation, and
   nothing dereferences ctx->map's pointee through this read. If stale,
   drop the reference and fall through to a normal re-import.

3. two smaller leaks found while fixing (1)

   dma_buf_io_create_map()'s WARN_ON_ONCE(!map->seg_shift) driver-bug
   guard returned without unmapping. The map was already fully formed
   by that point (dev_ops->map() and dma_buf_io_init_map() had both
   run, including the new ctx pin from fix 1), so this leaked the
   driver's mapping, the map struct, and now also ctx -- and therefore
   the dma_buf reference ctx holds -- permanently. Not reachable with
   the current NVMe driver (it enforces its own segment-shift invariant
   before returning), but became a strictly worse leak once maps started
   pinning ctx, so worth closing now rather than carrying forward.

   dma_buf_io_ctx_create()'s ops-table completeness check
   (WARN_ON_ONCE, now covering the free_map addition from the previous
   commit) returned -EINVAL without calling the driver's release() or
   releasing the dma_buf reference taken earlier in the function, on
   the exact kind of mistake -- a driver forgetting to wire up a
   newly-added mandatory callback -- that adding free_map just made
   newly possible.

Also: after dropping a stale req->dmabuf_map, clear the field to NULL
as well as the flag. Not required for safety (every reader already
gates on REQ_F_DROP_DMABUF), just removes a dangling pointer that
outlives its meaning.
---
 drivers/dma-buf/dma-buf-io.c | 79 ++++++++++++++++++++++++++++++++----
 io_uring/rsrc.c              | 43 +++++++++++++++++++-
 2 files changed, 112 insertions(+), 10 deletions(-)

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index 993d83d43701..0b921833431a 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -99,13 +99,12 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	struct dma_buf_io_ctx *ctx = map->ctx;
 	struct dma_buf *dmabuf = ctx->dmabuf;
 
-	/* the release path must wait for fences */
-	if (WARN_ON_ONCE(refcount_read(&ctx->refs) == 0))
-		return;
-
-	/* Prevent from destroying the ctx while unmapping */
-	refcount_inc(&ctx->refs);
-
+	/*
+	 * ctx is guaranteed alive here: dma_buf_io_init_map() pinned it for
+	 * this map's entire lifetime, and that pin is only dropped below,
+	 * after unmap. No late/opportunistic increment needed or safe -- see
+	 * the comment at the refcount_inc() site in dma_buf_io_init_map().
+	 */
 	dma_resv_lock(dmabuf->resv, NULL);
 	ctx->dev_ops->unmap(ctx, map);
 	dma_resv_unlock(dmabuf->resv);
@@ -115,6 +114,7 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	/* Drop the ctx's own (publication-time) software reference. */
 	kref_put(&map->refs, __dma_buf_io_map_free);
 
+	/* Drop this map's pin on ctx, taken in dma_buf_io_init_map(). */
 	if (refcount_dec_and_test(&ctx->refs)) {
 		/*
 		 * Destruction needs to wait for I/O and dma fences. Defer it to
@@ -188,6 +188,24 @@ int dma_buf_io_init_map(struct dma_buf_io_ctx *ctx, struct dma_buf_io_map *map)
 	kref_init(&map->refs);
 	init_completion(&map->drain);
 	INIT_WORK(&map->release_work, dma_buf_io_map_release_work);
+
+	/*
+	 * Pin ctx alive for this map's entire lifetime, from here until
+	 * dma_buf_io_map_release_work() (or the synchronous-drain fallback in
+	 * dma_buf_io_drop_map()) finishes unmap and drops it below.
+	 *
+	 * This must be an unconditional reference taken up front, not one
+	 * acquired opportunistically later next to dma_fence_signal(): the
+	 * fence can signal from dma_buf_io_map_active_release(), which runs
+	 * as soon as the last active ref drops -- e.g. from an NVMe IRQ --
+	 * strictly before dma_buf_io_map_release_work() is even scheduled,
+	 * let alone running. A waiter (dma_buf_io_ctx_release_work()) can
+	 * observe that signal and drop ctx's own reference before a
+	 * late-acquired protective reference would ever be taken, freeing
+	 * ctx out from under the still-queued worker. Taking it here removes
+	 * the ordering dependency on when the worker happens to run.
+	 */
+	refcount_inc(&ctx->refs);
 	return 0;
 }
 EXPORT_SYMBOL_NS_GPL(dma_buf_io_init_map, "DMA_BUF");
@@ -234,6 +252,24 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 	}
 
 	if (WARN_ON_ONCE(!map->seg_shift)) {
+		/*
+		 * Driver bug: ->map() returned successfully without setting
+		 * seg_shift. The map is otherwise fully formed (init_map()
+		 * already ran, including the ctx pin below), so unwind it
+		 * exactly as the normal unmap path would rather than leak
+		 * ctx, the driver's mapping, and the dma_buf reference ctx
+		 * holds. Nothing else can be using this map yet -- it was
+		 * never published to ctx->map -- so no active-ref drain is
+		 * needed.
+		 */
+		ctx->dev_ops->unmap(ctx, map);
+		percpu_ref_exit(&map->active);
+		kfree(map->fence);
+		kref_put(&map->refs, __dma_buf_io_map_free);
+		if (refcount_dec_and_test(&ctx->refs)) {
+			INIT_WORK(&ctx->release_work, dma_buf_io_ctx_destroy_work);
+			queue_work(system_wq, &ctx->release_work);
+		}
 		ret = -EFAULT;
 		goto out;
 	}
@@ -286,6 +322,20 @@ static void dma_buf_io_drop_map(struct dma_buf_io_ctx *ctx)
 		map->fence = NULL;
 		percpu_ref_exit(&map->active);
 		kref_put(&map->refs, __dma_buf_io_map_free);
+
+		/*
+		 * Drop this map's pin on ctx (taken in dma_buf_io_init_map()).
+		 * dma_resv is held here (this function's own contract), and
+		 * ctx->dev_ops->release() -> dma_buf_detach() is expected to
+		 * take it too, so a same-context ctx destruction must be
+		 * deferred, not called inline -- mirrors
+		 * dma_buf_io_map_release_work(), which only reaches the
+		 * equivalent decrement after unlocking.
+		 */
+		if (refcount_dec_and_test(&ctx->refs)) {
+			INIT_WORK(&ctx->release_work, dma_buf_io_ctx_destroy_work);
+			queue_work(system_wq, &ctx->release_work);
+		}
 		return;
 	}
 
@@ -383,8 +433,21 @@ int dma_buf_io_ctx_create(struct file *file,
 			 !ctx->dev_ops->map ||
 			 !ctx->dev_ops->unmap ||
 			 !ctx->dev_ops->release ||
-			 !ctx->dev_ops->free_map))
+			 !ctx->dev_ops->free_map)) {
+		/*
+		 * Driver bug: init_dma_buf_io_ctx() succeeded but left the
+		 * ops table incomplete (e.g. forgot the newly-added
+		 * free_map). Unwind whatever driver-side state it already
+		 * set up (attach, etc.) via release() if we can safely call
+		 * it, then release the dma_buf reference taken above --
+		 * otherwise both leak permanently.
+		 */
+		if (ctx->dev_ops && ctx->dev_ops->release)
+			ctx->dev_ops->release(ctx);
+		memset(ctx, 0, sizeof(*ctx));
+		dma_buf_put(dmabuf);
 		return -EINVAL;
+	}
 
 	return ret;
 }
diff --git a/io_uring/rsrc.c b/io_uring/rsrc.c
index d6b803c4bf05..3d7bf6f8395c 100644
--- a/io_uring/rsrc.c
+++ b/io_uring/rsrc.c
@@ -1304,6 +1304,40 @@ void io_drop_dmabuf_node(struct io_kiocb *req)
 	req->flags &= ~REQ_F_DROP_DMABUF;
 }
 
+/*
+ * A reissued request may hold a map imported before the exporter
+ * invalidated it and published a new generation -- io_uring's reissue
+ * mechanism re-queues the same req without clearing REQ_F_DROP_DMABUF or
+ * dropping req->dmabuf_map. Reusing a stale map is memory-safe (the
+ * software kref keeps its memory allocated regardless of ->active state)
+ * but would spuriously fail active acquisition at the driver instead of
+ * succeeding against the current mapping.
+ *
+ * Pointer comparison against ctx->map is sufficient without RCU read-side
+ * protection: we already hold our own kref on @map, so its memory cannot
+ * be freed and reused for a different generation out from under this
+ * comparison, and we are only comparing addresses, never dereferencing
+ * ctx->map's pointee.
+ *
+ * Returns the still-current map, or NULL if it was stale -- in which case
+ * the stale software reference has already been dropped and
+ * REQ_F_DROP_DMABUF cleared, so the caller can fall through to a normal
+ * re-import.
+ */
+static struct dma_buf_io_map *io_dmabuf_reuse_map(struct io_kiocb *req,
+						   struct io_regbuf_dma *db)
+{
+	struct dma_buf_io_map *map = req->dmabuf_map;
+
+	if (likely(rcu_access_pointer(db->ctx.map) == map))
+		return map;
+
+	dma_buf_io_map_drop(map);
+	req->flags &= ~REQ_F_DROP_DMABUF;
+	req->dmabuf_map = NULL;
+	return NULL;
+}
+
 static int io_import_dmabuf(struct io_kiocb *req,
 			   int ddir, struct iov_iter *iter,
 			   struct io_mapped_ubuf *imu,
@@ -1321,8 +1355,9 @@ static int io_import_dmabuf(struct io_kiocb *req,
 		return -EBADF;
 
 	if (req->flags & REQ_F_DROP_DMABUF) {
-		map = req->dmabuf_map;
-		goto init_iter;
+		map = io_dmabuf_reuse_map(req, db);
+		if (map)
+			goto init_iter;
 	}
 
 	map = dma_buf_io_get_map(&db->ctx);
@@ -1387,6 +1422,10 @@ static int io_import_dmabuf_vec(struct io_kiocb *req,
 		return 0;
 	}
 
+	if (!new_map) {
+		map = io_dmabuf_reuse_map(req, db);
+		new_map = !map;
+	}
 	if (new_map) {
 		map = dma_buf_io_get_map(&db->ctx);
 		if (unlikely(!map)) {
-- 
2.43.0

