From 7b0af7de4d18df26c2fcf874587f83d57eafbd80 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj1072538@gmail.com>
Date: Tue, 8 Sep 2026 15:14:03 +0530
Subject: [PATCH 2/3] nvme-pci: acquire the dma-buf active reference at
 hardware submission

Wire NVMe into the map->active reference from the previous commit,
taken and dropped at the actual hardware boundary rather than at
io_uring import time.

Acquire: first statement of nvme_rq_setup_dmabuf(), before
nvme_pci_dmabuf_sgl_nents() or either setup helper reads any driver DMA
state (map->sgt, map->dma_list, ...). Everything downstream of this
point is already GFP_ATOMIC (dma_pool_alloc() for PRP/SGL
descriptors), so the reference's held window contains no reclaim-
capable allocation.

Release: last statement of nvme_rq_clean_dmabuf_map(), after
nvme_dmabuf_map_sync_for_cpu() (which still needs a live mapping).

Enforce the boundary with an IOD_DMABUF_ACTIVE flag rather than trust
call-site discipline:

  - nvme_req_dmabuf_map() is now the only accessor to driver DMA state
    outside the unmap callback, and WARN_ON_ONCE()s if the flag isn't
    set. All read sites (both sync helpers, both setup helpers) go
    through it instead of touching bio->bi_dmabuf_map directly.
  - nvme_dmabuf_put_active() is a no-op unless the flag is set, so it
    is safe to call unconditionally from any exit path -- double-puts
    become structurally impossible rather than something to audit for.
  - nvme_prep_rq() WARN_ON_ONCE()s the flag is clear *before* its
    `iod->flags = 0` reset. That reset runs on every requeue; without
    the assertion ahead of it, a leaked reference from a prior pass
    would be silently erased before anything could catch it.

nvme_prep_rq()'s failure path (out_free_cmd) skips nvme_unmap_data()
entirely, so nvme_rq_clean_dmabuf_map() does not run for a request
that fails setup. Every such exit inside nvme_rq_setup_dmabuf_map()
and nvme_rq_setup_dmabuf_sgl() now calls nvme_dmabuf_put_active()
locally before returning.

A tryget failure at the funnel (map generation invalidated by exporter
migration) returns NVME_STS_DMABUF_GENERATION_LOST, a documented
BLK_STS_IOERR placeholder -- not BLK_STS_AGAIN, which
include/linux/blk_types.h reserves for RQF_NOWAIT requests whose bio
would block, which this is not. The choice also has to survive
nvme_queue_rqs(): nvme_prep_rq_batch() previously collapsed
nvme_prep_rq()'s return to bool, so any failure -- including a dead
generation -- looped through requeue_list indefinitely, since nothing
about a terminal failure changes on retry. It now returns the real
blk_status_t, and nvme_queue_rqs() ends BLK_STS_OK/RESOURCE/
DEV_RESOURCE as before but ends anything else via
blk_mq_end_request() immediately.

Choosing BLK_STS_IOERR (-EIO) also means io_uring's transparent
reissue never triggers for this failure without any io_uring-side
change: io_rw_should_reissue() and REQ_F_REISSUE are both gated on
-EAGAIN (or -EOPNOTSUPP for the non-IOPOLL completion path), neither
of which -EIO satisfies. This matters because one direct I/O can
produce several requests, and a generation loss between their
nvme_queue_rq() calls would otherwise let io_uring reissue a range
that already completed against the old mapping -- unsafe duplicate
I/O under concurrent writers or on zoned namespaces, not merely
redundant. -EIO is not the right errno for a recoverable, retryable
condition; it is the smallest change for this prototype. A dedicated
status (mapping to something like -ESTALE) is a block/uAPI decision
that needs sign-off before this is upstreamable, and userspace still
needs telling that a generation-loss completion may cover a request
that was only partially submitted.

Also add the driver's ->free_map() implementation the previous commit's
RCU-deferred destruction requires: a plain kfree() of the container,
run from an RCU callback with no ctx/attach/dmabuf access.
---
 drivers/nvme/host/pci.c | 207 +++++++++++++++++++++++++++++++++++++---
 1 file changed, 193 insertions(+), 14 deletions(-)

diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 8edf67d84d7b..ccede53171d5 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -506,6 +506,16 @@ enum nvme_iod_flags {
 
 	/* Metadata using non-coalesced MPTR */
 	IOD_SINGLE_META_SEGMENT	= 1U << 7,
+
+	/*
+	 * This request holds the dma-buf active reference on
+	 * req->bio->bi_dmabuf_map. Set only by a successful
+	 * nvme_dmabuf_tryget_active(), cleared only by
+	 * nvme_dmabuf_put_active(). Driver DMA state on the map may only be
+	 * accessed through nvme_req_dmabuf_map() while this is set -- see
+	 * struct dma_buf_io_map::active in include/linux/dma-buf-io.h.
+	 */
+	IOD_DMABUF_ACTIVE	= 1U << 8,
 };
 
 struct nvme_dma_vec {
@@ -953,13 +963,96 @@ to_nvme_dmabuf_map(struct dma_buf_io_map *map)
 	return container_of(map, struct nvme_dmabuf_map, base);
 }
 
+/*
+ * Status returned when a request's dma-buf map generation was invalidated
+ * (exporter-driven migration) before nvme_queue_rq() could acquire the
+ * active reference. This is a PROTOTYPE placeholder:
+ *
+ *  - It must never be BLK_STS_AGAIN. include/linux/blk_types.h reserves that
+ *    for RQF_NOWAIT requests whose bio would block; a generation-loss
+ *    rejection satisfies neither condition.
+ *  - It must be terminal, not requeued: nvme_prep_rq_batch() and
+ *    nvme_queue_rqs() must end the request via blk_mq_end_request(), not
+ *    loop it through requeue_list (see the batch-status-preservation work).
+ *  - It must not trigger io_uring's transparent -EAGAIN reissue: one direct
+ *    I/O can produce several requests, and blkdev_dio does not track a
+ *    completed-prefix byte count, so blind reissue would re-issue an
+ *    already-transferred range -- unsafe duplicate I/O, not merely
+ *    redundant, under concurrent writers or zoned namespaces.
+ *
+ * BLK_STS_IOERR is the smallest change for this prototype but is not
+ * semantically accurate: userspace sees -EIO for a recoverable condition.
+ * A dedicated status (design notes propose an -ESTALE mapping) is a
+ * block/uAPI decision that needs sign-off before this is upstreamable.
+ */
+#define NVME_STS_DMABUF_GENERATION_LOST	BLK_STS_IOERR
+
+/*
+ * Acquire the active (hardware DMA) reference on this request's map. Must be
+ * called as the very first thing in the dma-buf submission funnel
+ * (nvme_rq_setup_dmabuf()), before anything reads driver DMA state -- see
+ * nvme_pci_dmabuf_sgl_nents(), which reads map->sgt before either setup
+ * helper runs.
+ *
+ * Returns false if the map has been invalidated (migration in progress);
+ * the caller must fail the request rather than touch any driver map state.
+ */
+static bool nvme_dmabuf_tryget_active(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	if (WARN_ON_ONCE(iod->flags & IOD_DMABUF_ACTIVE))
+		return true;
+
+	if (!dma_buf_io_map_active_tryget(req->bio->bi_dmabuf_map))
+		return false;
+
+	iod->flags |= IOD_DMABUF_ACTIVE;
+	return true;
+}
+
+/*
+ * Release the active reference. Safe to call unconditionally from any exit
+ * path -- a no-op unless IOD_DMABUF_ACTIVE is set, so it cannot double-put.
+ * Must be called exactly once per successful tryget: from normal completion
+ * (nvme_rq_clean_dmabuf_map()) or from local rollback on every setup failure
+ * that does not route through completion (nvme_prep_rq()'s out_free_cmd
+ * skips nvme_unmap_data() entirely, so those paths cannot rely on
+ * nvme_rq_clean_dmabuf_map() running for them).
+ */
+static void nvme_dmabuf_put_active(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	if (!(iod->flags & IOD_DMABUF_ACTIVE))
+		return;
+
+	iod->flags &= ~IOD_DMABUF_ACTIVE;
+	dma_buf_io_map_active_put(req->bio->bi_dmabuf_map);
+}
+
+/*
+ * The only accessor for driver DMA state outside the unmap callback (which
+ * runs at active == 0 by definition and uses to_nvme_dmabuf_map() directly).
+ * Asserts the active reference is actually held, so a future patch that
+ * reads map state without first taking the reference fails loudly instead of
+ * racing an in-progress unmap.
+ */
+static inline struct nvme_dmabuf_map *nvme_req_dmabuf_map(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	WARN_ON_ONCE(!(iod->flags & IOD_DMABUF_ACTIVE));
+	return to_nvme_dmabuf_map(req->bio->bi_dmabuf_map);
+}
+
 static void nvme_dmabuf_map_sync_for_cpu(struct nvme_dev *nvme_dev,
 					 struct request *req)
 {
 	struct device *dev = nvme_dev->dev;
 	enum dma_data_direction dma_dir;
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	dma_addr_t *dma_list = map->dma_list;
 	unsigned offset = bio->bi_iter.bi_offset;
 	unsigned map_idx = offset / NVME_CTRL_PAGE_SIZE;
@@ -981,7 +1074,7 @@ static void nvme_dmabuf_map_sync_for_device(struct nvme_dev *nvme_dev,
 	struct device *dev = nvme_dev->dev;
 	enum dma_data_direction dma_dir;
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	dma_addr_t *dma_list = map->dma_list;
 	unsigned offset = bio->bi_iter.bi_offset;
 	unsigned map_idx = offset / NVME_CTRL_PAGE_SIZE;
@@ -997,6 +1090,13 @@ static void nvme_dmabuf_map_sync_for_device(struct nvme_dev *nvme_dev,
 	}
 }
 
+/*
+ * Normal completion funnel. Must run for every request that reached a
+ * successful nvme_dmabuf_tryget_active() and completed submission -- i.e.
+ * every path that does NOT bypass nvme_unmap_data() via nvme_prep_rq()'s
+ * out_free_cmd. The active put is last: nvme_dmabuf_map_sync_for_cpu() still
+ * needs a live, active-held mapping.
+ */
 static void nvme_rq_clean_dmabuf_map(struct nvme_dev *dev,
 				      struct request *req)
 {
@@ -1006,6 +1106,8 @@ static void nvme_rq_clean_dmabuf_map(struct nvme_dev *dev,
 
 	if (!(iod->flags & IOD_SINGLE_SEGMENT))
 		nvme_free_descriptors(req);
+
+	nvme_dmabuf_put_active(req);
 }
 
 static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
@@ -1013,7 +1115,7 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 {
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	unsigned bvec_done = bio->bi_iter.bi_offset;
 	unsigned map_idx = bvec_done / NVME_CTRL_PAGE_SIZE;
 	unsigned offset = bvec_done & (NVME_CTRL_PAGE_SIZE - 1);
@@ -1062,8 +1164,11 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 
 	prp_list = dma_pool_alloc(nvme_dma_pool(nvmeq, iod), GFP_ATOMIC,
 			&prp_dma);
-	if (!prp_list)
+	if (!prp_list) {
+		/* Setup failure bypasses nvme_unmap_data(); roll back locally. */
+		nvme_dmabuf_put_active(req);
 		return BLK_STS_RESOURCE;
+	}
 
 	iod->descriptors[iod->nr_descriptors++] = prp_list;
 	prp2_dma = prp_dma;
@@ -1095,6 +1200,7 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 	return BLK_STS_OK;
 free_prps:
 	nvme_free_descriptors(req);
+	nvme_dmabuf_put_active(req);
 	return BLK_STS_RESOURCE;
 }
 
@@ -1407,10 +1513,14 @@ static void nvme_pci_sgl_set_seg(struct nvme_sgl_desc *sge,
 	sge->type = NVME_SGL_FMT_LAST_SEG_DESC << 4;
 }
 
+/*
+ * Called from nvme_rq_setup_dmabuf() after its tryget, so the active
+ * reference is already held here.
+ */
 static unsigned int nvme_pci_dmabuf_sgl_nents(struct request *req)
 {
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	struct scatterlist *sg;
 	unsigned long tmp;
 	size_t offset = bio->bi_iter.bi_offset;
@@ -1450,7 +1560,7 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 {
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	size_t length = blk_rq_payload_bytes(req);
 	struct nvme_sgl_desc *sg_list = &iod->cmd.common.dptr.sgl;
 	bool pooled = entries > 1;
@@ -1461,8 +1571,11 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 	size_t offset = bio->bi_iter.bi_offset;
 	size_t remaining = length;
 
-	if (!entries)
+	if (!entries) {
+		/* Setup failure bypasses nvme_unmap_data(); roll back locally. */
+		nvme_dmabuf_put_active(req);
 		return BLK_STS_IOERR;
+	}
 
 	iod->cmd.common.flags = NVME_CMD_SGL_METABUF;
 	iod->total_len = length;
@@ -1476,8 +1589,10 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 
 		sg_list = dma_pool_alloc(nvme_dma_pool(nvmeq, iod), GFP_ATOMIC,
 					 &sgl_dma);
-		if (!sg_list)
+		if (!sg_list) {
+			nvme_dmabuf_put_active(req);
 			return BLK_STS_RESOURCE;
+		}
 		iod->descriptors[iod->nr_descriptors++] = sg_list;
 	}
 
@@ -1521,6 +1636,7 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 		iod->nr_descriptors--;
 		dma_pool_free(nvme_dma_pool(nvmeq, iod), sg_list, sgl_dma);
 	}
+	nvme_dmabuf_put_active(req);
 	return BLK_STS_IOERR;
 }
 
@@ -1530,6 +1646,15 @@ static blk_status_t nvme_rq_setup_dmabuf(struct request *req,
 	unsigned int entries;
 	size_t avg_seg;
 
+	/*
+	 * Must be the first statement: nothing below may read driver DMA
+	 * state (map->sgt, map->dma_list, ...) before this succeeds. See
+	 * nvme_req_dmabuf_map()'s assertion and the ->active comment in
+	 * include/linux/dma-buf-io.h.
+	 */
+	if (!nvme_dmabuf_tryget_active(req))
+		return NVME_STS_DMABUF_GENERATION_LOST;
+
 	if (use_sgl == SGL_UNSUPPORTED)
 		return nvme_rq_setup_dmabuf_map(req, nvmeq);
 
@@ -1793,6 +1918,14 @@ static blk_status_t nvme_prep_rq(struct request *req)
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	blk_status_t ret;
 
+	/*
+	 * A leaked active reference from a prior pass (this request being
+	 * requeued) would otherwise be silently erased by the flags reset
+	 * below, defeating exactly the path -- requeue -- most likely to
+	 * leak one. Must run before the reset.
+	 */
+	WARN_ON_ONCE(iod->flags & IOD_DMABUF_ACTIVE);
+
 	iod->flags = 0;
 	iod->nr_descriptors = 0;
 	iod->total_len = 0;
@@ -1871,18 +2004,27 @@ static void nvme_submit_cmds(struct nvme_queue *nvmeq, struct rq_list *rqlist)
 	spin_unlock(&nvmeq->sq_lock);
 }
 
-static bool nvme_prep_rq_batch(struct nvme_queue *nvmeq, struct request *req)
+/*
+ * Returns the actual blk_status_t from nvme_prep_rq() -- previously
+ * collapsed to bool, which made every failure indistinguishable from a
+ * resource shortage and therefore always requeued. A dma-buf
+ * generation-loss rejection is terminal (see
+ * NVME_STS_DMABUF_GENERATION_LOST) and must not be requeued: requeuing
+ * re-runs nvme_prep_rq() against the same dead map generation, which can
+ * only ever fail the same way again.
+ */
+static blk_status_t nvme_prep_rq_batch(struct nvme_queue *nvmeq, struct request *req)
 {
 	/*
 	 * We should not need to do this, but we're still using this to
 	 * ensure we can drain requests on a dying queue.
 	 */
 	if (unlikely(!test_bit(NVMEQ_ENABLED, &nvmeq->flags)))
-		return false;
+		return BLK_STS_DEV_RESOURCE;
 	if (unlikely(!nvme_check_ready(&nvmeq->dev->ctrl, req, true)))
-		return false;
+		return BLK_STS_DEV_RESOURCE;
 
-	return nvme_prep_rq(req) == BLK_STS_OK;
+	return nvme_prep_rq(req);
 }
 
 static void nvme_queue_rqs(struct rq_list *rqlist)
@@ -1893,14 +2035,37 @@ static void nvme_queue_rqs(struct rq_list *rqlist)
 	struct request *req;
 
 	while ((req = rq_list_pop(rqlist))) {
+		blk_status_t ret;
+
 		if (nvmeq && nvmeq != req->mq_hctx->driver_data)
 			nvme_submit_cmds(nvmeq, &submit_list);
 		nvmeq = req->mq_hctx->driver_data;
 
-		if (nvme_prep_rq_batch(nvmeq, req))
+		ret = nvme_prep_rq_batch(nvmeq, req);
+		switch (ret) {
+		case BLK_STS_OK:
 			rq_list_add_tail(&submit_list, req);
-		else
+			break;
+		case BLK_STS_RESOURCE:
+		case BLK_STS_DEV_RESOURCE:
 			rq_list_add_tail(&requeue_list, req);
+			break;
+		default:
+			/*
+			 * Terminal failure (including
+			 * NVME_STS_DMABUF_GENERATION_LOST): end the request
+			 * now rather than requeue it. Requeuing here would
+			 * loop it through nvme_queue_rqs() indefinitely
+			 * against the same generation, since nothing about a
+			 * terminal failure changes by retrying. No need to
+			 * flush submit_list first -- ending this request
+			 * doesn't interact with the unrelated ones already
+			 * prepared for this nvmeq; they still flush at the
+			 * normal points (nvmeq switch or loop exit).
+			 */
+			blk_mq_end_request(req, ret);
+			break;
+		}
 	}
 
 	if (nvmeq)
@@ -3140,10 +3305,24 @@ static void nvme_dma_buf_io_release(struct dma_buf_io_ctx *ctx)
 	kfree(priv);
 }
 
+/*
+ * Called from an RCU callback after the last software (kref) reference
+ * drops -- which can be long after this map's ctx has been destroyed (a
+ * lingering io_uring request can outlive ctx teardown). Must not touch
+ * ctx/attach/dmabuf, only free the container. dev_ops->unmap() already
+ * freed prp_array and undid the dma_buf attachment; this only frees the
+ * struct nvme_dmabuf_map allocation itself (map_base is its first member).
+ */
+static void nvme_dma_buf_io_free_map(struct dma_buf_io_map *map_base)
+{
+	kfree(to_nvme_dmabuf_map(map_base));
+}
+
 const struct dma_buf_io_ops nvme_dma_buf_io_ops = {
 	.map		= nvme_dma_buf_io_map,
 	.unmap		= nvme_dma_buf_io_unmap,
 	.release	= nvme_dma_buf_io_release,
+	.free_map	= nvme_dma_buf_io_free_map,
 };
 
 static int nvme_pci_init_dma_buf_io_ctx(struct nvme_ctrl *ctrl,
