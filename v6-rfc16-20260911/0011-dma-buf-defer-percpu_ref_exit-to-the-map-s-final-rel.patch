From 75bf618739d36fd390120be826abc432e6048552 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Fri, 11 Sep 2026 19:33:20 +0530
Subject: [PATCH 11/16] dma-buf: defer percpu_ref_exit() to the map's final
 release

Moving active-reference acquisition to hardware submission will allow a
request to retain a software map reference after the DMA mapping has been
unmapped. Such a request can still call percpu_ref_tryget_live() and needs
the percpu_ref storage to remain initialized.

Prepare for that separation by calling percpu_ref_exit() only after the
map's final software reference has been released.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index 432cf97cf2ab..8e1f36b43963 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -54,6 +54,7 @@ static void dma_buf_io_map_free_rcu(struct rcu_head *rcu)
 	struct dma_buf_io_map *map = container_of(rcu, struct dma_buf_io_map, rcu);
 	struct dma_buf_io_ctx *ctx = map->ctx;
 
+	percpu_ref_exit(&map->active);
 	kfree(map);
 	dma_buf_io_ctx_put(ctx);
 }
@@ -86,7 +87,6 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	dma_resv_unlock(dmabuf->resv);
 
 	dma_fence_put(fence);
-	percpu_ref_exit(&map->active);
 	kref_put(&map->refs, __dma_buf_io_map_free);
 }
 
