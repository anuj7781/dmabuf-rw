From 88f69b6b88adb687c174b3cb0b5c56bf79456d44 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 14:52:49 +0530
Subject: [PATCH 04/16] dma-buf: wait for fences under the reservation lock

Map creation must observe a stable set of DMA-BUF fences. Take the
reservation lock before waiting and keep it held until the new mapping
has been created.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index fbf91db5617e..0821f740681a 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -113,19 +113,6 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 	struct dma_buf_io_map *map;
 	long ret;
 
-retry:
-	/*
-	 * ->dmabuf_map() will be calling dma_buf_map_attachment(), for which
-	 * we'll need to wait for fences. Do a bit nicer and try to wait
-	 * without the resv lock first.
-	 */
-	ret = dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL,
-				    true, MAX_SCHEDULE_TIMEOUT);
-	if (!ret)
-		ret = -EAGAIN;
-	if (ret < 0)
-		return ERR_PTR(ret);
-
 	ret = dma_resv_lock_interruptible(dmabuf->resv, NULL);
 	if (ret)
 		return ERR_PTR(ret);
@@ -136,11 +123,17 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 		goto out;
 	}
 
-	if (dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL,
-				  true, 0) < 0) {
-		dma_resv_unlock(dmabuf->resv);
-		goto retry;
-	}
+	/*
+	 * ->map() will call dma_buf_map_attachment(), which requires the
+	 * exporter's outstanding fences to have retired first. Wait here,
+	 * under the reservation lock.
+	 */
+	ret = dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL, true,
+				    MAX_SCHEDULE_TIMEOUT);
+	if (ret == 0)
+		ret = -ETIMEDOUT;
+	if (ret < 0)
+		goto out;
 
 	map = ctx->dev_ops->map(ctx);
 	if (IS_ERR(map)) {
