From 71506cb8cf3f5e069271b3a0dda7ad5ddb98dae2 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 14:54:52 +0530
Subject: [PATCH 05/16] dma-buf: unwind incomplete DMA-BUF I/O contexts

An importer can initialize private state before the common code
validates its operations table. Release that state and the DMA-BUF
reference when validation fails.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index 0821f740681a..81f5e5cf60c1 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -260,8 +260,13 @@ int dma_buf_io_ctx_create(struct file *file,
 	if (WARN_ON_ONCE(!ctx->dev_ops ||
 			 !ctx->dev_ops->map ||
 			 !ctx->dev_ops->unmap ||
-			 !ctx->dev_ops->release))
+			 !ctx->dev_ops->release)) {
+		if (ctx->dev_ops && ctx->dev_ops->release)
+			ctx->dev_ops->release(ctx);
+		memset(ctx, 0, sizeof(*ctx));
+		dma_buf_put(dmabuf);
 		return -EINVAL;
+	}
 
 	return ret;
 }
