From 94317a90310268e447fc9f62d5b8578896f940de Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Tue, 4 Aug 2026 10:07:47 +0530
Subject: [PATCH] nvme-pci: reuse a precomputed PRP list for dma-buf backed I/O

Precompute a PRP list for the whole registered dma-buf at map time,
bounded by the existing io_uring dma-buf size limit. I/O whose PRP
list fits within a single page of it can point directly into the
precomputed array instead of allocating a fresh page from the
per-NUMA descriptor pool on every I/O. Falls back to the existing
pool path when the slice crosses a page boundary, or when the
precomputed array couldn't be allocated.

Suggested-by: Caleb Sander Mateos <csander@purestorage.com>
Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/nvme/host/pci.c | 55 ++++++++++++++++++++++++++++++++++++++---
 1 file changed, 52 insertions(+), 3 deletions(-)

diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 67e26d6e8f25..d1c772d5dc51 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -399,6 +399,8 @@ struct nvme_dmabuf_map {
 	struct dma_buf_io_map base;
 	struct sg_table *sgt;
 	unsigned nr_entries;
+	__le64 *prp_array;
+	dma_addr_t prp_array_dma;
 	dma_addr_t dma_list[];
 };
 
@@ -958,6 +960,25 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 		goto done;
 	}
 
+	/*
+	 * The precomputed prp_array has no chain pointers, so a slice of it
+	 * can only be used directly as PRP2 if the whole slice this request
+	 * needs lies within a single physical page of the array.
+	 */
+	if (map->prp_array) {
+		unsigned int nprps = DIV_ROUND_UP(length, NVME_CTRL_PAGE_SIZE);
+		dma_addr_t prp_list_start = map->prp_array_dma +
+				map_idx * sizeof(*map->prp_array);
+		dma_addr_t prp_list_end = prp_list_start +
+				nprps * sizeof(*map->prp_array);
+
+		if ((prp_list_start >> NVME_CTRL_PAGE_SHIFT) ==
+		    ((prp_list_end - 1) >> NVME_CTRL_PAGE_SHIFT)) {
+			prp2_dma = prp_list_start;
+			goto done;
+		}
+	}
+
 	if (DIV_ROUND_UP(length, NVME_CTRL_PAGE_SIZE) <=
 	    NVME_SMALL_POOL_SIZE / sizeof(__le64))
 		iod->flags |= IOD_SMALL_DESCRIPTOR;
@@ -2593,6 +2614,21 @@ static struct dma_buf_io_map *nvme_dma_buf_io_map(struct dma_buf_io_ctx *ctx)
 	if (!map)
 		return ERR_PTR(-ENOMEM);
 
+	/*
+	 * Precomputed PRP list for the whole dmabuf, so I/O whose PRP list
+	 * fits in a single page can point directly into it instead of
+	 * allocating a fresh page from the per-NUMA descriptor pool on every
+	 * I/O. Purely an optimization: cap the size defensively regardless
+	 * of the io_uring-side dmabuf size limit, and treat any failure to
+	 * allocate as non-fatal, falling back to the descriptor pool path.
+	 */
+	if (nr_entries * sizeof(*map->prp_array) <= SZ_4M)
+		map->prp_array = dma_alloc_coherent(attach->dev,
+				nr_entries * sizeof(*map->prp_array),
+				&map->prp_array_dma, GFP_KERNEL);
+	else
+		map->prp_array = NULL;
+
 	sgt = dma_buf_map_attachment(attach, ctx->dir);
 	if (IS_ERR(sgt)) {
 		ret = PTR_ERR(sgt);
@@ -2611,14 +2647,19 @@ static struct dma_buf_io_map *nvme_dma_buf_io_map(struct dma_buf_io_ctx *ctx)
 		seg_shift = min(seg_shift, __ffs(sg_len));
 
 		while (sg_len) {
-			map->dma_list[i++] = dma_addr;
+			map->dma_list[i] = dma_addr;
+			if (map->prp_array)
+				map->prp_array[i] = cpu_to_le64(dma_addr);
+			i++;
 			dma_addr += NVME_CTRL_PAGE_SIZE;
 			sg_len -= NVME_CTRL_PAGE_SIZE;
 		}
 	}
 
-	if (WARN_ON_ONCE(seg_shift < NVME_CTRL_PAGE_SHIFT))
-		return ERR_PTR(-EFAULT);
+	if (WARN_ON_ONCE(seg_shift < NVME_CTRL_PAGE_SHIFT)) {
+		ret = -EFAULT;
+		goto err;
+	}
 
 	ret = dma_buf_io_init_map(ctx, &map->base);
 	if (ret)
@@ -2630,6 +2671,10 @@ static struct dma_buf_io_map *nvme_dma_buf_io_map(struct dma_buf_io_ctx *ctx)
 err:
 	if (sgt)
 		dma_buf_unmap_attachment(attach, sgt, ctx->dir);
+	if (map->prp_array)
+		dma_free_coherent(attach->dev,
+				  nr_entries * sizeof(*map->prp_array),
+				  map->prp_array, map->prp_array_dma);
 	kfree(map);
 	return ERR_PTR(ret);
 }
@@ -2642,6 +2687,10 @@ static void nvme_dma_buf_io_unmap(struct dma_buf_io_ctx *ctx,
 
 	dma_resv_assert_held(ctx->dmabuf->resv);
 
+	if (map->prp_array)
+		dma_free_coherent(attach->dev,
+				  map->nr_entries * sizeof(*map->prp_array),
+				  map->prp_array, map->prp_array_dma);
 	dma_buf_unmap_attachment(attach, map->sgt, ctx->dir);
 }
 
