From 16ed2a629e7dbdd3fdd1bb136da4b173516d3891 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 15:48:47 +0530
Subject: [PATCH 12/15] nvme-pci: acquire the dma-buf active reference at
 hardware submission

Acquire the dma-buf active reference at hardware submission and release it on completion or setup failure. Preserve terminal generation-loss status in batched requests so invalidated mappings are ended instead of requeued.

Signed-off-by: Anuj Gupta <anuj1072538@gmail.com>

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index 432cf97cf2ab..bbcb5212cf9e 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -8,6 +8,8 @@
 #include <linux/dma-resv.h>
 #include <linux/file.h>
 
+static struct workqueue_struct *dma_buf_io_wq;
+
 static const char *dma_buf_io_fence_drv_name(struct dma_fence *fence)
 {
 	return "dma-buf-io-ctx";
@@ -38,11 +40,6 @@ static void dma_buf_io_ctx_destroy_work(struct work_struct *work)
 	fput(file);
 }
 
-/*
- * Drop a ctx reference, deferring the final free to a worker. Callers may be
- * holding dma_resv, which ctx->dev_ops->release() -> dma_buf_detach() takes
- * as well, so the free can never run inline from here.
- */
 static void dma_buf_io_ctx_put(struct dma_buf_io_ctx *ctx)
 {
 	if (refcount_dec_and_test(&ctx->refs))
@@ -74,29 +71,30 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	struct dma_buf_io_ctx *ctx = map->ctx;
 	struct dma_buf *dmabuf = ctx->dmabuf;
 
-	/*
-	 * There are no more requests using the map, we can signal the fence.
-	 * It should be done before taking the resv lock as someone could be
-	 * waiting for the fence while holding the lock.
-	 */
-	dma_fence_signal(fence);
-
 	dma_resv_lock(dmabuf->resv, NULL);
 	ctx->dev_ops->unmap(ctx, map);
 	dma_resv_unlock(dmabuf->resv);
 
-	dma_fence_put(fence);
-	percpu_ref_exit(&map->active);
+		dma_fence_put(fence);
 	kref_put(&map->refs, __dma_buf_io_map_free);
 }
 
 static void dma_buf_io_map_active_release(struct percpu_ref *ref)
 {
 	struct dma_buf_io_map *map = container_of(ref, struct dma_buf_io_map, active);
+	bool cookie;
 
-	/* might sleep, use a worker */
-	INIT_WORK(&map->release_work, dma_buf_io_map_release_work);
-	queue_work(system_wq, &map->release_work);
+	cookie = dma_fence_begin_signalling();
+
+	if (map->release_mode == DMA_BUF_IO_RELEASE_SYNC) {
+		complete(&map->drain);
+	} else {
+		dma_fence_signal(map->fence);
+		INIT_WORK(&map->release_work, dma_buf_io_map_release_work);
+		queue_work(dma_buf_io_wq, &map->release_work);
+	}
+
+	dma_fence_end_signalling(cookie);
 }
 
 int dma_buf_io_init_map(struct dma_buf_io_ctx *ctx, struct dma_buf_io_map *map)
@@ -115,13 +113,11 @@ int dma_buf_io_init_map(struct dma_buf_io_ctx *ctx, struct dma_buf_io_map *map)
 		return ret;
 	}
 
-	dma_fence_init(fence, &dma_buf_io_fence_ops, NULL, ctx->fence_ctx,
-		       atomic_inc_return(&ctx->fence_seq));
 	map->fence = fence;
 	map->ctx = ctx;
 	kref_init(&map->refs);
+	init_completion(&map->drain);
 
-	/* Keep ctx alive until the map's final release. */
 	refcount_inc(&ctx->refs);
 	return 0;
 }
@@ -163,8 +159,8 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 
 	if (WARN_ON_ONCE(!map->seg_shift)) {
 		ctx->dev_ops->unmap(ctx, map);
-		dma_fence_put(map->fence);
-		percpu_ref_exit(&map->active);
+		/* The fence has not been initialized. */
+		kfree(map->fence);
 		kref_put(&map->refs, __dma_buf_io_map_free);
 		ret = -EFAULT;
 		goto out;
@@ -172,7 +168,6 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 
 	/* Return a caller reference in addition to the publication reference. */
 	kref_get(&map->refs);
-	percpu_ref_get(&map->active);
 	rcu_assign_pointer(ctx->map, map);
 out:
 	dma_resv_unlock(dmabuf->resv);
@@ -197,20 +192,24 @@ static void dma_buf_io_drop_map(struct dma_buf_io_ctx *ctx)
 
 	ret = dma_resv_reserve_fences(dmabuf->resv, 1);
 	if (WARN_ON_ONCE(ret)) {
-		struct dma_fence *fence = map->fence;
-
-		dma_fence_get(fence);
+		/* No fence can be published, so drain synchronously. */
+		map->release_mode = DMA_BUF_IO_RELEASE_SYNC;
 		percpu_ref_kill(&map->active);
-		dma_fence_wait(fence, false);
-		dma_fence_put(fence);
+		wait_for_completion(&map->drain);
+
+		ctx->dev_ops->unmap(ctx, map);
+		kfree(map->fence);
+		map->fence = NULL;
+		percpu_ref_exit(&map->active);
+		kref_put(&map->refs, __dma_buf_io_map_free);
 		return;
 	}
 
+	dma_fence_init(map->fence, &dma_buf_io_fence_ops, NULL, ctx->fence_ctx,
+		       atomic_inc_return(&ctx->fence_seq));
 	dma_resv_add_fence(dmabuf->resv, map->fence, DMA_RESV_USAGE_KERNEL);
-	/*
-	 * Delay destruction until all inflight requests using the map are
-	 * gone. It'll also signal the fence then.
-	 */
+	map->release_mode = DMA_BUF_IO_RELEASE_FENCED;
+	/* Delay unmap until all active users are gone. */
 	percpu_ref_kill(&map->active);
 }
 
@@ -291,3 +290,12 @@ int dma_buf_io_ctx_create(struct file *file,
 
 	return ret;
 }
+
+static int __init dma_buf_io_init(void)
+{
+	dma_buf_io_wq = alloc_workqueue("dma_buf_io", WQ_MEM_RECLAIM | WQ_UNBOUND, 0);
+	if (!dma_buf_io_wq)
+		return -ENOMEM;
+	return 0;
+}
+subsys_initcall(dma_buf_io_init);
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 868524ca3575..84519870048d 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -427,6 +427,12 @@ enum nvme_iod_flags {
 
 	/* Metadata using non-coalesced MPTR */
 	IOD_SINGLE_META_SEGMENT	= 1U << 7,
+
+	/* Request holds the dma-buf active reference. */
+	IOD_DMABUF_ACTIVE	= 1U << 8,
+
+	/* Keep last; used to verify the flags field width. */
+	IOD_FLAGS_LAST,
 };
 
 struct nvme_dma_vec {
@@ -440,7 +446,7 @@ struct nvme_dma_vec {
 struct nvme_iod {
 	struct nvme_request req;
 	struct nvme_command cmd;
-	u8 flags;
+	u16 flags;
 	u8 nr_descriptors;
 
 	size_t total_len;
@@ -874,13 +880,54 @@ to_nvme_dmabuf_map(struct dma_buf_io_map *map)
 	return container_of(map, struct nvme_dmabuf_map, base);
 }
 
+/* The current block status for a request whose map was invalidated. */
+#define NVME_STS_DMABUF_GENERATION_LOST	BLK_STS_IOERR
+
+/* Acquire the active reference before accessing the driver DMA map. */
+static bool nvme_dmabuf_tryget_active(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	BUILD_BUG_ON((IOD_FLAGS_LAST - 1) > (typeof(iod->flags))~0U);
+
+	if (WARN_ON_ONCE(iod->flags & IOD_DMABUF_ACTIVE))
+		return true;
+
+	if (!dma_buf_io_map_active_tryget(req->bio->bi_dmabuf_map))
+		return false;
+
+	iod->flags |= IOD_DMABUF_ACTIVE;
+	return true;
+}
+
+/* Release the active reference, if this request acquired one. */
+static void nvme_dmabuf_put_active(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	if (!(iod->flags & IOD_DMABUF_ACTIVE))
+		return;
+
+	iod->flags &= ~IOD_DMABUF_ACTIVE;
+	dma_buf_io_map_active_put(req->bio->bi_dmabuf_map);
+}
+
+/* Access driver DMA state while the request holds the active reference. */
+static inline struct nvme_dmabuf_map *nvme_req_dmabuf_map(struct request *req)
+{
+	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
+
+	WARN_ON_ONCE(!(iod->flags & IOD_DMABUF_ACTIVE));
+	return to_nvme_dmabuf_map(req->bio->bi_dmabuf_map);
+}
+
 static void nvme_dmabuf_map_sync_for_cpu(struct nvme_dev *nvme_dev,
 					 struct request *req)
 {
 	struct device *dev = nvme_dev->dev;
 	enum dma_data_direction dma_dir;
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	dma_addr_t *dma_list = map->dma_list;
 	unsigned offset = bio->bi_iter.bi_offset;
 	unsigned map_idx = offset / NVME_CTRL_PAGE_SIZE;
@@ -902,7 +949,7 @@ static void nvme_dmabuf_map_sync_for_device(struct nvme_dev *nvme_dev,
 	struct device *dev = nvme_dev->dev;
 	enum dma_data_direction dma_dir;
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	dma_addr_t *dma_list = map->dma_list;
 	unsigned offset = bio->bi_iter.bi_offset;
 	unsigned map_idx = offset / NVME_CTRL_PAGE_SIZE;
@@ -918,6 +965,13 @@ static void nvme_dmabuf_map_sync_for_device(struct nvme_dev *nvme_dev,
 	}
 }
 
+/*
+ * Normal completion funnel. Must run for every request that reached a
+ * successful nvme_dmabuf_tryget_active() and completed submission -- i.e.
+ * every path that does NOT bypass nvme_unmap_data() via nvme_prep_rq()'s
+ * out_free_cmd. The active put is last: nvme_dmabuf_map_sync_for_cpu() still
+ * needs a live, active-held mapping.
+ */
 static void nvme_rq_clean_dmabuf_map(struct nvme_dev *dev,
 				      struct request *req)
 {
@@ -927,6 +981,8 @@ static void nvme_rq_clean_dmabuf_map(struct nvme_dev *dev,
 
 	if (!(iod->flags & IOD_SINGLE_SEGMENT))
 		nvme_free_descriptors(req);
+
+	nvme_dmabuf_put_active(req);
 }
 
 static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
@@ -934,7 +990,7 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 {
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	unsigned bvec_done = bio->bi_iter.bi_offset;
 	unsigned map_idx = bvec_done / NVME_CTRL_PAGE_SIZE;
 	unsigned offset = bvec_done & (NVME_CTRL_PAGE_SIZE - 1);
@@ -964,8 +1020,11 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 
 	prp_list = dma_pool_alloc(nvme_dma_pool(nvmeq, iod), GFP_ATOMIC,
 			&prp_dma);
-	if (!prp_list)
+	if (!prp_list) {
+		/* Setup failure bypasses nvme_unmap_data(); roll back locally. */
+		nvme_dmabuf_put_active(req);
 		return BLK_STS_RESOURCE;
+	}
 
 	iod->descriptors[iod->nr_descriptors++] = prp_list;
 	prp2_dma = prp_dma;
@@ -997,6 +1056,7 @@ static blk_status_t nvme_rq_setup_dmabuf_map(struct request *req,
 	return BLK_STS_OK;
 free_prps:
 	nvme_free_descriptors(req);
+	nvme_dmabuf_put_active(req);
 	return BLK_STS_RESOURCE;
 }
 
@@ -1309,10 +1369,14 @@ static void nvme_pci_sgl_set_seg(struct nvme_sgl_desc *sge,
 	sge->type = NVME_SGL_FMT_LAST_SEG_DESC << 4;
 }
 
+/*
+ * Called from nvme_rq_setup_dmabuf() after its tryget, so the active
+ * reference is already held here.
+ */
 static unsigned int nvme_pci_dmabuf_sgl_nents(struct request *req)
 {
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	struct scatterlist *sg;
 	unsigned long tmp;
 	size_t offset = bio->bi_iter.bi_offset;
@@ -1352,7 +1416,7 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 {
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	struct bio *bio = req->bio;
-	struct nvme_dmabuf_map *map = to_nvme_dmabuf_map(bio->bi_dmabuf_map);
+	struct nvme_dmabuf_map *map = nvme_req_dmabuf_map(req);
 	size_t length = blk_rq_payload_bytes(req);
 	struct nvme_sgl_desc *sg_list = &iod->cmd.common.dptr.sgl;
 	bool pooled = entries > 1;
@@ -1363,8 +1427,11 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 	size_t offset = bio->bi_iter.bi_offset;
 	size_t remaining = length;
 
-	if (!entries)
+	if (!entries) {
+		/* Setup failure bypasses nvme_unmap_data(); roll back locally. */
+		nvme_dmabuf_put_active(req);
 		return BLK_STS_IOERR;
+	}
 
 	iod->cmd.common.flags = NVME_CMD_SGL_METABUF;
 	iod->total_len = length;
@@ -1378,8 +1445,10 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 
 		sg_list = dma_pool_alloc(nvme_dma_pool(nvmeq, iod), GFP_ATOMIC,
 					 &sgl_dma);
-		if (!sg_list)
+		if (!sg_list) {
+			nvme_dmabuf_put_active(req);
 			return BLK_STS_RESOURCE;
+		}
 		iod->descriptors[iod->nr_descriptors++] = sg_list;
 	}
 
@@ -1423,6 +1492,7 @@ static blk_status_t nvme_rq_setup_dmabuf_sgl(struct request *req,
 		iod->nr_descriptors--;
 		dma_pool_free(nvme_dma_pool(nvmeq, iod), sg_list, sgl_dma);
 	}
+	nvme_dmabuf_put_active(req);
 	return BLK_STS_IOERR;
 }
 
@@ -1432,6 +1502,15 @@ static blk_status_t nvme_rq_setup_dmabuf(struct request *req,
 	unsigned int entries;
 	size_t avg_seg;
 
+	/*
+	 * Must be the first statement: nothing below may read driver DMA
+	 * state (map->sgt, map->dma_list, ...) before this succeeds. See
+	 * nvme_req_dmabuf_map()'s assertion and the ->active comment in
+	 * include/linux/dma-buf-io.h.
+	 */
+	if (!nvme_dmabuf_tryget_active(req))
+		return NVME_STS_DMABUF_GENERATION_LOST;
+
 	if (use_sgl == SGL_UNSUPPORTED)
 		return nvme_rq_setup_dmabuf_map(req, nvmeq);
 
@@ -1695,6 +1774,14 @@ static blk_status_t nvme_prep_rq(struct request *req)
 	struct nvme_iod *iod = blk_mq_rq_to_pdu(req);
 	blk_status_t ret;
 
+	/*
+	 * A leaked active reference from a prior pass (this request being
+	 * requeued) would otherwise be silently erased by the flags reset
+	 * below, defeating exactly the path -- requeue -- most likely to
+	 * leak one. Must run before the reset.
+	 */
+	WARN_ON_ONCE(iod->flags & IOD_DMABUF_ACTIVE);
+
 	iod->flags = 0;
 	iod->nr_descriptors = 0;
 	iod->total_len = 0;
@@ -1773,18 +1860,27 @@ static void nvme_submit_cmds(struct nvme_queue *nvmeq, struct rq_list *rqlist)
 	spin_unlock(&nvmeq->sq_lock);
 }
 
-static bool nvme_prep_rq_batch(struct nvme_queue *nvmeq, struct request *req)
+/*
+ * Returns the actual blk_status_t from nvme_prep_rq() -- previously
+ * collapsed to bool, which made every failure indistinguishable from a
+ * resource shortage and therefore always requeued. A dma-buf
+ * generation-loss rejection (NVME_STS_DMABUF_GENERATION_LOST) is terminal
+ * and must not be requeued: requeuing re-runs nvme_prep_rq() against the
+ * same dead map generation, which can only ever fail the same way again.
+ */
+static blk_status_t nvme_prep_rq_batch(struct nvme_queue *nvmeq,
+				       struct request *req)
 {
 	/*
 	 * We should not need to do this, but we're still using this to
 	 * ensure we can drain requests on a dying queue.
 	 */
 	if (unlikely(!test_bit(NVMEQ_ENABLED, &nvmeq->flags)))
-		return false;
+		return BLK_STS_DEV_RESOURCE;
 	if (unlikely(!nvme_check_ready(&nvmeq->dev->ctrl, req, true)))
-		return false;
+		return BLK_STS_DEV_RESOURCE;
 
-	return nvme_prep_rq(req) == BLK_STS_OK;
+	return nvme_prep_rq(req);
 }
 
 static void nvme_queue_rqs(struct rq_list *rqlist)
@@ -1795,14 +1891,37 @@ static void nvme_queue_rqs(struct rq_list *rqlist)
 	struct request *req;
 
 	while ((req = rq_list_pop(rqlist))) {
+		blk_status_t ret;
+
 		if (nvmeq && nvmeq != req->mq_hctx->driver_data)
 			nvme_submit_cmds(nvmeq, &submit_list);
 		nvmeq = req->mq_hctx->driver_data;
 
-		if (nvme_prep_rq_batch(nvmeq, req))
+		ret = nvme_prep_rq_batch(nvmeq, req);
+		switch (ret) {
+		case BLK_STS_OK:
 			rq_list_add_tail(&submit_list, req);
-		else
+			break;
+		case BLK_STS_RESOURCE:
+		case BLK_STS_DEV_RESOURCE:
 			rq_list_add_tail(&requeue_list, req);
+			break;
+		default:
+			/*
+			 * Terminal failure (including
+			 * NVME_STS_DMABUF_GENERATION_LOST): end the request
+			 * now rather than requeue it. Requeuing here would
+			 * loop it through nvme_queue_rqs() indefinitely
+			 * against the same generation, since nothing about a
+			 * terminal failure changes by retrying. No need to
+			 * flush submit_list first -- ending this request
+			 * doesn't interact with the unrelated ones already
+			 * prepared for this nvmeq; they still flush at the
+			 * normal points (nvmeq switch or loop exit).
+			 */
+			blk_mq_end_request(req, ret);
+			break;
+		}
 	}
 
 	if (nvmeq)
