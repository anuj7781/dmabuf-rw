 	if (unlikely(iov_iter_is_folioq(i)))
 		return !i->count ? 0 :
@@ -791,6 +823,21 @@ void iov_iter_dmabuf_map(struct iov_iter *i, unsigned int direction,
 	};
 }
 
+void iov_iter_dmabuf_map_vec(struct iov_iter *i, unsigned int direction,
+			const struct dma_buf_io_vec *desc, size_t count)
+{
+	WARN_ON(direction & ~(READ | WRITE));
+	*i = (struct iov_iter){
+		.iter_type = ITER_DMABUF_MAP_VEC,
+		.data_source = direction,
+		.dmabuf_vec = desc,
+		.nr_segs = desc->nr_iovs,
+		.iov_offset = 0,
+		.count = count,
+	};
+}
+EXPORT_SYMBOL(iov_iter_dmabuf_map_vec);
