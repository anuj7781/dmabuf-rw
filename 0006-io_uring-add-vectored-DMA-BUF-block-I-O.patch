 		i->iov_offset += size;
 		i->count -= size;
 	} else if (likely(iter_is_iovec(i) || iov_iter_is_kvec(i))) {
@@ -679,6 +705,12 @@ size_t iov_iter_single_seg_count(const struct iov_iter *i)
 			return min(i->count, iter_iov(i)->iov_len - i->iov_offset);
 		if (iov_iter_is_bvec(i))
 			return min(i->count, i->bvec->bv_len - i->iov_offset);
+		if (iov_iter_is_dmabuf_map_vec(i)) {
+			const struct dma_buf_io_vec *desc = i->dmabuf_vec;
+			const struct iovec *iov = &desc->iov[desc->nr_iovs - i->nr_segs];
+
+			return min(i->count, iov->iov_len - i->iov_offset);
+		}
