+static void iov_iter_dmabuf_map_vec_advance(struct iov_iter *i, size_t size)
+{
+	const struct dma_buf_io_vec *desc = i->dmabuf_vec;
+
+	if (!i->count)
+		return;
+
+	while (size && i->nr_segs) {
+		const struct iovec *iov = &desc->iov[desc->nr_iovs - i->nr_segs];
+		size_t avail = iov->iov_len - i->iov_offset;
+
+		if (size < avail) {
+			i->iov_offset += size;
+			i->count -= size;
+			return;
+		}
+		size -= avail;
+		i->count -= avail;
+		i->nr_segs--;
+		i->iov_offset = 0;
+	}
+}
+
 static void iov_iter_iovec_advance(struct iov_iter *i, size_t size)
 {
 	const struct iovec *iov, *end;
@@ -575,8 +599,10 @@ void iov_iter_advance(struct iov_iter *i, size_t size)
 {
 	if (unlikely(i->count < size))
