From b7120246f0b00bc38eeae862a06bfbd585d61417 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Fri, 7 Aug 2026 11:05:08 +0530
Subject: [PATCH 1/3] nvme: enable dma-buf backed passthrough I/O

Pass IO_REGBUF_IMPORT_ALLOW_DMABUF from io_uring_cmd_import_fixed() so
NVMe uring_cmd passthrough can use a registered dma-buf. Add
nvme_ns_chr_init_dma_buf_io_ctx() so the NVMe generic char device can
register one too. Reject dma-buf import combined with metadata in
nvme_uring_cmd_io(), since the dma-buf path doesn't support metadata.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/nvme/host/core.c  | 18 ++++++++++++++++++
 drivers/nvme/host/ioctl.c |  4 ++++
 io_uring/uring_cmd.c      |  3 ++-
 3 files changed, 24 insertions(+), 1 deletion(-)

diff --git a/drivers/nvme/host/core.c b/drivers/nvme/host/core.c
index 8bd407603d92..2d0f4c5be49c 100644
--- a/drivers/nvme/host/core.c
+++ b/drivers/nvme/host/core.c
@@ -3949,6 +3949,23 @@ static int nvme_ns_chr_release(struct inode *inode, struct file *file)
 	return 0;
 }
 
+/*
+ * The chardev has no read/write path of its own (ioctl/uring_cmd only), so
+ * unlike the block device there's no buffered I/O fallback that a dmabuf
+ * backed iterator could end up in - no O_DIRECT precondition needed here.
+ */
+static int nvme_ns_chr_init_dma_buf_io_ctx(struct file *file,
+					   struct dma_buf_io_ctx *ctx)
+{
+	struct nvme_ns *ns = container_of(file_inode(file)->i_cdev,
+					  struct nvme_ns, cdev);
+	struct nvme_ctrl *ctrl = ns->ctrl;
+
+	if (!ctrl->ops->init_dma_buf_io_ctx)
+		return -EINVAL;
+	return ctrl->ops->init_dma_buf_io_ctx(ctrl, ctx);
+}
+
 static const struct file_operations nvme_ns_chr_fops = {
 	.owner		= THIS_MODULE,
 	.open		= nvme_ns_chr_open,
@@ -3957,6 +3974,7 @@ static const struct file_operations nvme_ns_chr_fops = {
 	.compat_ioctl	= compat_ptr_ioctl,
 	.uring_cmd	= nvme_ns_chr_uring_cmd,
 	.uring_cmd_iopoll = nvme_ns_chr_uring_cmd_iopoll,
+	.init_dma_buf_io_ctx = nvme_ns_chr_init_dma_buf_io_ctx,
 };
 
 static void nvme_add_ns_cdev(struct nvme_ns *ns)
diff --git a/drivers/nvme/host/ioctl.c b/drivers/nvme/host/ioctl.c
index 664216eece4a..b82d04fe5d0f 100644
--- a/drivers/nvme/host/ioctl.c
+++ b/drivers/nvme/host/ioctl.c
@@ -7,6 +7,7 @@
 #include <linux/ptrace.h>	/* for force_successful_syscall_return */
 #include <linux/nvme_ioctl.h>
 #include <linux/io_uring/cmd.h>
+#include <linux/uio.h>
 #include "nvme.h"
 
 enum {
@@ -501,6 +502,9 @@ static int nvme_uring_cmd_io(struct nvme_ctrl *ctrl, struct nvme_ns *ns,
 		if (ret < 0)
 			return ret;
 
+		if (unlikely(iov_iter_is_dmabuf_map(&iter) && d.metadata_len))
+			return -EOPNOTSUPP;
+
 		map_iter = &iter;
 	}
 
diff --git a/io_uring/uring_cmd.c b/io_uring/uring_cmd.c
index 37f24008ef13..025422fe435b 100644
--- a/io_uring/uring_cmd.c
+++ b/io_uring/uring_cmd.c
@@ -300,7 +300,8 @@ int io_uring_cmd_import_fixed(u64 ubuf, unsigned long len, int rw,
 	if (WARN_ON_ONCE(!(ioucmd->flags & IORING_URING_CMD_FIXED)))
 		return -EINVAL;
 
-	return io_import_reg_buf(req, iter, ubuf, len, rw, issue_flags);
+	return __io_import_reg_buf(req, iter, ubuf, len, rw, issue_flags,
+				   IO_REGBUF_IMPORT_ALLOW_DMABUF);
 }
 EXPORT_SYMBOL_GPL(io_uring_cmd_import_fixed);
 
