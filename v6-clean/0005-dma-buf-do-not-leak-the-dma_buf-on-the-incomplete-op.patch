From ef5d86330f126818c33e866a5965fb59548e06a9 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 14:54:52 +0530
Subject: [PATCH 05/17] dma-buf: do not leak the dma_buf on the incomplete-ops
 path

dma_buf_io_ctx_create(), added in patch 1 of "Add dmabuf read/write via
io_uring", takes a dma_buf reference with get_dma_buf() and then calls
the driver's init_dma_buf_io_ctx(). If that succeeds but leaves the ops
table incomplete, the validation below returns -EINVAL directly:

	if (WARN_ON_ONCE(!ctx->dev_ops || ...))
		return -EINVAL;

unlike the init failure path just above it, which does memset the ctx
and drop the reference. So the dma_buf reference leaks permanently, and
so does whatever driver-side state init_dma_buf_io_ctx() set up before
returning -- typically a dma_buf_attach().

Unwind the driver's state via release() when the ops table is complete
enough to call it, then clear the ctx and drop the reference, matching
the path above.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/dma-buf/dma-buf-io.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index da1530ec1057..bb6763ffdd72 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -267,8 +267,20 @@ int dma_buf_io_ctx_create(struct file *file,
 	if (WARN_ON_ONCE(!ctx->dev_ops ||
 			 !ctx->dev_ops->map ||
 			 !ctx->dev_ops->unmap ||
-			 !ctx->dev_ops->release))
+			 !ctx->dev_ops->release)) {
+		/*
+		 * Driver bug: init_dma_buf_io_ctx() succeeded but left the ops
+		 * table incomplete. Unwind whatever driver-side state it
+		 * already set up (attach, etc.) via release() if we can safely
+		 * call it, then drop the dma_buf reference taken above --
+		 * otherwise both leak permanently.
+		 */
+		if (ctx->dev_ops && ctx->dev_ops->release)
+			ctx->dev_ops->release(ctx);
+		memset(ctx, 0, sizeof(*ctx));
+		dma_buf_put(dmabuf);
 		return -EINVAL;
+	}
 
 	return ret;
 }
