From 337c34899067775af4d2d5ff8341865c834fae6a Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 14:52:49 +0530
Subject: [PATCH 04/17] dma-buf: wait for fences under the reservation lock
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

dma_buf_io_create_map(), added in patch 1 of "Add dmabuf read/write via
io_uring", waits for the exporter's fences twice: once before taking the
reservation lock with MAX_SCHEDULE_TIMEOUT, then again under the lock
with a zero timeout, dropping the lock and restarting the whole sequence
if that second wait finds anything outstanding.

Christian König NAK'd exactly this on v4:

  Clear NAK to that. Always wait while holding the resv lock if you can!
  It is absolutely not beneficial to do this outside of the lock and
  usually just hides problems instead and prevent fixing them.

Waiting under the lock is explicitly permitted by dma_resv, so do that:
lock, check the cache, wait, map, unlock. The unlock/retry loop goes
away, and with it the window in which the fence set could change between
the wait succeeding and ->map() running -- which is the class of problem
the pre-lock wait was hiding.

The zero-timeout probe also had a subtle bug of its own: it tested
"< 0", so a return of 0 (fences still outstanding) fell through to
->map() instead of retrying. That disappears with the restructure.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/dma-buf/dma-buf-io.c | 29 +++++++++++------------------
 1 file changed, 11 insertions(+), 18 deletions(-)

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index c2fd4a43d333..da1530ec1057 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -113,19 +113,6 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 	struct dma_buf_io_map *map;
 	long ret;
 
-retry:
-	/*
-	 * ->dmabuf_map() will be calling dma_buf_map_attachment(), for which
-	 * we'll need to wait for fences. Do a bit nicer and try to wait
-	 * without the resv lock first.
-	 */
-	ret = dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL,
-				    true, MAX_SCHEDULE_TIMEOUT);
-	if (!ret)
-		ret = -EAGAIN;
-	if (ret < 0)
-		return ERR_PTR(ret);
-
 	ret = dma_resv_lock_interruptible(dmabuf->resv, NULL);
 	if (ret)
 		return ERR_PTR(ret);
@@ -136,11 +123,17 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 		goto out;
 	}
 
-	if (dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL,
-				  true, 0) < 0) {
-		dma_resv_unlock(dmabuf->resv);
-		goto retry;
-	}
+	/*
+	 * ->map() will call dma_buf_map_attachment(), which requires the
+	 * exporter's outstanding fences to have retired first. Wait here,
+	 * under the reservation lock.
+	 */
+	ret = dma_resv_wait_timeout(dmabuf->resv, DMA_RESV_USAGE_KERNEL, true,
+				    MAX_SCHEDULE_TIMEOUT);
+	if (ret == 0)
+		ret = -ETIMEDOUT;
+	if (ret < 0)
+		goto out;
 
 	map = ctx->dev_ops->map(ctx);
 	if (IS_ERR(map)) {
-- 
2.43.0

