From 53d5438272e012b2948fc2673dd3bd70614537f0 Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 14:52:12 +0530
Subject: [PATCH 03/17] dma-buf: unlock the reservation on the seg_shift
 driver-bug path

dma_buf_io_create_map(), added in patch 1 of "Add dmabuf read/write via
io_uring", checks that the driver's ->map() set seg_shift:

	if (WARN_ON_ONCE(!map->seg_shift))
		return ERR_PTR(-EFAULT);

That return happens with dmabuf->resv held, and every other exit from
the function goes through the out: label to unlock it. So a driver that
forgets to set seg_shift does not just get a warning and an error -- it
permanently leaks the exporter's reservation lock, deadlocking every
subsequent map, unmap and eviction on that buffer.

The same path also leaks everything ->map() and dma_buf_io_init_map()
allocated: the driver's DMA mapping, the fence, the percpu_ref and the
map itself.

Unwind properly and exit through out:. Nothing can be using the map at
this point because it has not been published to ctx->map yet, so no
drain is needed; percpu_ref_exit() on a ref that was never killed is the
documented init-failure pattern.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/dma-buf/dma-buf-io.c | 17 +++++++++++++++--
 1 file changed, 15 insertions(+), 2 deletions(-)

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index 6834a79700ce..c2fd4a43d333 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -148,8 +148,21 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 		goto out;
 	}
 
-	if (WARN_ON_ONCE(!map->seg_shift))
-		return ERR_PTR(-EFAULT);
+	if (WARN_ON_ONCE(!map->seg_shift)) {
+		/*
+		 * Driver bug: ->map() returned successfully without setting
+		 * seg_shift. The map is otherwise fully formed, so unwind
+		 * everything ->map() and dma_buf_io_init_map() set up rather
+		 * than leaking the driver's mapping. Nothing can be using it
+		 * yet -- it was never published to ctx->map.
+		 */
+		ctx->dev_ops->unmap(ctx, map);
+		dma_fence_put(map->fence);
+		percpu_ref_exit(&map->refs);
+		kfree(map);
+		ret = -EFAULT;
+		goto out;
+	}
 
 	percpu_ref_get(&map->refs);
 	rcu_assign_pointer(ctx->map, map);
-- 
