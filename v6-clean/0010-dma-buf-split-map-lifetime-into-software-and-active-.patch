From eef6ed2ccea6915f0cb1af55f47ab0e4a653440e Mon Sep 17 00:00:00 2001
From: Anuj Gupta <anuj20.g@samsung.com>
Date: Thu, 10 Sep 2026 15:35:57 +0530
Subject: [PATCH 10/17] dma-buf: split map lifetime into software and active
 references
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The file I/O infrastructure added in patch 1 of "Add dmabuf read/write
via io_uring" uses one percpu_ref (map->refs) for two different things:
"some importer still holds a pointer to this struct" and "the DMA
mapping may still be in use." Every importer holds that single reference
for the request's whole lifetime, including allocation, tag assignment
and bio splitting -- all reclaim-capable -- so the fence-signalling path
(queued from the release callback) ends up implicitly depending on
whatever those importers do while holding it.

Split the counter along the actual boundary:

  - map->refs (kref): "some importer holds a pointer." Taken by
    dma_buf_io_get_map() / dma_buf_io_create_map(), dropped by
    dma_buf_io_map_drop(). Never gates the DMA mapping.
  - map->active (percpu_ref): "the DMA mapping may still be in use."
    Killed by dma_buf_io_drop_map() on invalidation; dev_ops->unmap()
    only runs once every reference taken before the kill is returned.

For now ->active is acquired and released at exactly the same points as
->refs -- import and drop -- so this is v5's original single counter,
split into two, with no change in when unmap happens. A later change
moves ->active's acquisition to a driver's hardware-submission funnel;
until then the two move together and are never held independently.

ctx now takes an explicit, unconditional reference on itself in
dma_buf_io_init_map() (refcount_inc(&ctx->refs)), pinning it for the
map's entire lifetime rather than the previous
WARN_ON_ONCE(refcount_read()==0) then refcount_inc() in the release
worker -- Christian König flagged that exact check-then-increment as
"usually illegal" on v4. The pin is dropped once the release worker's
unmap() call returns.

Because ->refs is a plain kref now, its release is synchronous and can
in principle race a concurrent dma_buf_io_get_map() that is mid
kref_get_unless_zero() on memory about to be freed. Free the map's
container through an RCU callback (dev_ops->free_map(), analogous to
dma_buf_detach()'s existing pattern) instead of the direct kfree() v5
used, so an in-flight RCU read-side lookup always completes against
valid memory. Wire this up for nvme-pci.

Because a lingering importer can hold ->refs well past ctx teardown, the
final release must not dereference map->ctx (ctx may already be freed).
Cache dev_ops on the map at creation time and free through that cached
pointer instead of ctx->dev_ops.

Signed-off-by: Anuj Gupta <anuj20.g@samsung.com>
---
 drivers/dma-buf/dma-buf-io.c | 87 +++++++++++++++++++++++++++++-------
 drivers/nvme/host/pci.c      | 13 ++++++
 include/linux/dma-buf-io.h   | 84 +++++++++++++++++++++++++++++++---
 3 files changed, 162 insertions(+), 22 deletions(-)

diff --git a/drivers/dma-buf/dma-buf-io.c b/drivers/dma-buf/dma-buf-io.c
index ddcd653678fe..0d6574270737 100644
--- a/drivers/dma-buf/dma-buf-io.c
+++ b/drivers/dma-buf/dma-buf-io.c
@@ -54,6 +54,28 @@ static void dma_buf_io_ctx_put(struct dma_buf_io_ctx *ctx)
 		queue_work(system_wq, &ctx->destroy_work);
 }
 
+/*
+ * Final release of the software reference. May run long after ctx has been
+ * torn down (a lingering importer can hold the software reference past ctx
+ * teardown -- see the ->refs comment in dma-buf-io.h), so this must not
+ * dereference map->ctx. map->dev_ops was cached at creation time for
+ * exactly this reason.
+ */
+static void dma_buf_io_map_free_rcu(struct rcu_head *rcu)
+{
+	struct dma_buf_io_map *map = container_of(rcu, struct dma_buf_io_map, rcu);
+
+	map->dev_ops->free_map(map);
+}
+
+void __dma_buf_io_map_free(struct kref *kref)
+{
+	struct dma_buf_io_map *map = container_of(kref, struct dma_buf_io_map, refs);
+
+	call_rcu(&map->rcu, dma_buf_io_map_free_rcu);
+}
+EXPORT_SYMBOL_NS_GPL(__dma_buf_io_map_free, "DMA_BUF");
+
 static void dma_buf_io_map_release_work(struct work_struct *work)
 {
 	struct dma_buf_io_map *map = container_of(work, struct dma_buf_io_map,
@@ -62,12 +84,11 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	struct dma_buf_io_ctx *ctx = map->ctx;
 	struct dma_buf *dmabuf = ctx->dmabuf;
 
-	/* the release path must wait for fences */
-	if (WARN_ON_ONCE(refcount_read(&ctx->refs) == 0))
-		return;
-
-	/* Prevent from destoying the ctx while unmapping */
-	refcount_inc(&ctx->refs);
+	/*
+	 * ctx is guaranteed alive here: dma_buf_io_init_map() pinned it for
+	 * this map's entire lifetime, and that pin is only dropped below,
+	 * after unmap.
+	 */
 
 	/*
 	 * There are no more requests using the map, we can signal the fence.
@@ -81,15 +102,17 @@ static void dma_buf_io_map_release_work(struct work_struct *work)
 	dma_resv_unlock(dmabuf->resv);
 
 	dma_fence_put(fence);
-	percpu_ref_exit(&map->refs);
-	kfree(map);
+	percpu_ref_exit(&map->active);
+	/* Drop ctx's own (publication-time) software reference. */
+	kref_put(&map->refs, __dma_buf_io_map_free);
 
+	/* Drop this map's pin on ctx, taken in dma_buf_io_init_map(). */
 	dma_buf_io_ctx_put(ctx);
 }
 
-static void dma_buf_io_map_refs_release(struct percpu_ref *ref)
+static void dma_buf_io_map_active_release(struct percpu_ref *ref)
 {
-	struct dma_buf_io_map *map = container_of(ref, struct dma_buf_io_map, refs);
+	struct dma_buf_io_map *map = container_of(ref, struct dma_buf_io_map, active);
 
 	/* might sleep, use a worker */
 	INIT_WORK(&map->release_work, dma_buf_io_map_release_work);
@@ -105,7 +128,8 @@ int dma_buf_io_init_map(struct dma_buf_io_ctx *ctx, struct dma_buf_io_map *map)
 	if (!fence)
 		return -ENOMEM;
 
-	ret = percpu_ref_init(&map->refs, dma_buf_io_map_refs_release, 0, GFP_KERNEL);
+	ret = percpu_ref_init(&map->active, dma_buf_io_map_active_release, 0,
+			      GFP_KERNEL);
 	if (ret) {
 		kfree(fence);
 		return ret;
@@ -115,6 +139,22 @@ int dma_buf_io_init_map(struct dma_buf_io_ctx *ctx, struct dma_buf_io_map *map)
 		       atomic_inc_return(&ctx->fence_seq));
 	map->fence = fence;
 	map->ctx = ctx;
+	map->dev_ops = ctx->dev_ops;
+	kref_init(&map->refs);
+
+	/*
+	 * Pin ctx alive for this map's entire lifetime: the active-release
+	 * worker above needs ctx->dev_ops and ctx->dmabuf->resv to call
+	 * unmap(), and it runs independently of whether any importer still
+	 * holds a software reference. Dropped by that worker once unmap()
+	 * has completed.
+	 *
+	 * Must be an unconditional reference taken up front, not the
+	 * WARN_ON_ONCE(refcount_read()==0) then refcount_inc() pattern this
+	 * function used to have here -- Christian König flagged exactly that
+	 * check-then-increment as "usually illegal" on v4.
+	 */
+	refcount_inc(&ctx->refs);
 	return 0;
 }
 EXPORT_SYMBOL_NS_GPL(dma_buf_io_init_map, "DMA_BUF");
@@ -163,13 +203,25 @@ struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx)
 		 */
 		ctx->dev_ops->unmap(ctx, map);
 		dma_fence_put(map->fence);
-		percpu_ref_exit(&map->refs);
-		kfree(map);
+		percpu_ref_exit(&map->active);
+		kref_put(&map->refs, __dma_buf_io_map_free);
+		/* Drop this map's pin on ctx, taken in dma_buf_io_init_map(). */
+		dma_buf_io_ctx_put(ctx);
 		ret = -EFAULT;
 		goto out;
 	}
 
-	percpu_ref_get(&map->refs);
+	/*
+	 * map->refs was kref_init()'d to 1 by dma_buf_io_init_map(), owned
+	 * by ctx (dropped by the release worker once this generation is
+	 * invalidated and unmapped). This get is the calling request's own
+	 * reference, matching the cache-hit path above.
+	 *
+	 * map->active is freshly percpu_ref_init()'d and nothing has had a
+	 * chance to kill it yet -- this cannot fail.
+	 */
+	kref_get(&map->refs);
+	percpu_ref_get(&map->active);
 	rcu_assign_pointer(ctx->map, map);
 out:
 	dma_resv_unlock(dmabuf->resv);
@@ -197,7 +249,7 @@ static void dma_buf_io_drop_map(struct dma_buf_io_ctx *ctx)
 		struct dma_fence *fence = map->fence;
 
 		dma_fence_get(fence);
-		percpu_ref_kill(&map->refs);
+		percpu_ref_kill(&map->active);
 		dma_fence_wait(fence, false);
 		dma_fence_put(fence);
 		return;
@@ -208,7 +260,7 @@ static void dma_buf_io_drop_map(struct dma_buf_io_ctx *ctx)
 	 * Delay destruction until all inflight requests using the map are
 	 * gone. It'll also signal the fence then.
 	 */
-	percpu_ref_kill(&map->refs);
+	percpu_ref_kill(&map->active);
 }
 
 void dma_buf_io_invalidate_mappings(struct dma_buf_io_ctx *ctx)
@@ -292,7 +344,8 @@ int dma_buf_io_ctx_create(struct file *file,
 	if (WARN_ON_ONCE(!ctx->dev_ops ||
 			 !ctx->dev_ops->map ||
 			 !ctx->dev_ops->unmap ||
-			 !ctx->dev_ops->release)) {
+			 !ctx->dev_ops->release ||
+			 !ctx->dev_ops->free_map)) {
 		/*
 		 * Driver bug: init_dma_buf_io_ctx() succeeded but left the ops
 		 * table incomplete. Unwind whatever driver-side state it
diff --git a/drivers/nvme/host/pci.c b/drivers/nvme/host/pci.c
index 868524ca3575..233752a1df77 100644
--- a/drivers/nvme/host/pci.c
+++ b/drivers/nvme/host/pci.c
@@ -2654,10 +2654,23 @@ static void nvme_dma_buf_io_release(struct dma_buf_io_ctx *ctx)
 	dma_buf_detach(ctx->dmabuf, attach);
 }
 
+/*
+ * Called from an RCU callback once the last software reference to @map_base
+ * is dropped: must not sleep or block. unmap() has always already run by
+ * this point (dma_buf_io_map::refs and ::active are ordered so that ->refs
+ * cannot reach zero before ->active's release worker finishes unmap), so
+ * there is nothing left to release here beyond the allocation itself.
+ */
+static void nvme_dma_buf_io_free_map(struct dma_buf_io_map *map_base)
+{
+	kfree(to_nvme_dmabuf_map(map_base));
+}
+
 const struct dma_buf_io_ops nvme_dma_buf_io_ops = {
 	.map		= nvme_dma_buf_io_map,
 	.unmap		= nvme_dma_buf_io_unmap,
 	.release	= nvme_dma_buf_io_release,
+	.free_map	= nvme_dma_buf_io_free_map,
 };
 
 static int nvme_pci_init_dma_buf_io_ctx(struct nvme_ctrl *ctrl,
diff --git a/include/linux/dma-buf-io.h b/include/linux/dma-buf-io.h
index f3adb7c5c4a2..7570f8f38c48 100644
--- a/include/linux/dma-buf-io.h
+++ b/include/linux/dma-buf-io.h
@@ -3,6 +3,8 @@
 #define __DMA_BUF_IO_H__
 
 #include <linux/dma-buf.h>
+#include <linux/kref.h>
+#include <linux/rcupdate.h>
 
 struct dma_buf_io_ctx;
 struct dma_buf_io_map;
@@ -25,14 +27,44 @@ struct dma_buf_io_ops {
 	 * parts of the token.
 	 */
 	void (*release)(struct dma_buf_io_ctx *);
+
+	/*
+	 * Free the driver's container of @map after an RCU grace period.
+	 * @map is the first member of the driver's container struct; the
+	 * driver must free that container, not just @map itself. Called
+	 * from an RCU callback: must not sleep or block.
+	 */
+	void (*free_map)(struct dma_buf_io_map *map);
 };
 
 struct dma_buf_io_map {
 	/*
-	 * Counts attached requests and other users. Device specific unmapping
-	 * is deferred until all refs are dropped.
+	 * Software reference: held by every holder of a *pointer* to this
+	 * struct -- ctx's own reference (kept until the active-release
+	 * worker has finished unmap, then dropped) and one reference per
+	 * importer (dma_buf_io_get_map() / dma_buf_io_create_map(), dropped
+	 * by dma_buf_io_map_drop()).
+	 *
+	 * Does NOT gate the DMA mapping and must never be used to decide
+	 * whether the mapping is still valid -- only ->active does that. May
+	 * be held across allocation, reclaim and scheduling.
+	 */
+	struct kref			refs;
+
+	/*
+	 * Active reference: gates the DMA mapping. Killed by
+	 * dma_buf_io_drop_map() on invalidation; dev_ops->unmap() only runs
+	 * once every reference taken before the kill has been returned.
+	 *
+	 * For now this is acquired and released at exactly the same points
+	 * as ->refs (import and drop) -- it is v5's original single counter,
+	 * split out but not yet retargeted. A later change moves acquisition
+	 * to a driver's hardware-submission funnel, at which point ->refs
+	 * and ->active stop moving together: ->refs is held for a whole
+	 * request's lifetime, ->active only while hardware may be using the
+	 * mapping.
 	 */
-	struct percpu_ref		refs;
+	struct percpu_ref		active;
 
 	/*
 	 * Guaranteed minimum DMA segment size in this mapping, as a
@@ -55,6 +87,16 @@ struct dma_buf_io_map {
 	struct work_struct		release_work;
 	struct dma_fence		*fence;
 	struct dma_buf_io_ctx		*ctx;
+	struct rcu_head			rcu;
+
+	/*
+	 * Cached from ctx->dev_ops at creation time. The final software
+	 * kref_put() can fire long after ctx has been destroyed (a lingering
+	 * importer can hold the software reference past ctx teardown -- see
+	 * the ->refs comment above), so the free path must not dereference
+	 * ->ctx.
+	 */
+	const struct dma_buf_io_ops	*dev_ops;
 };
 
 struct dma_buf_io_ctx {
@@ -99,6 +141,32 @@ void dma_buf_io_ctx_release(struct dma_buf_io_ctx *ctx);
 
 struct dma_buf_io_map *dma_buf_io_create_map(struct dma_buf_io_ctx *ctx);
 
+/* Internal: kref release for the software reference. Not for direct use. */
+void __dma_buf_io_map_free(struct kref *kref);
+
+/*
+ * dma_buf_io_map_active_tryget() / _put() manage the *active* reference --
+ * see struct dma_buf_io_map::active above for what it means and who may
+ * call these.
+ */
+static inline bool dma_buf_io_map_active_tryget(struct dma_buf_io_map *map)
+{
+	return percpu_ref_tryget_live(&map->active);
+}
+
+static inline void dma_buf_io_map_active_put(struct dma_buf_io_map *map)
+{
+	percpu_ref_put(&map->active);
+}
+
+/*
+ * dma_buf_io_get_map() / dma_buf_io_map_drop() manage the *software*
+ * reference: safe to hold across allocation, reclaim and scheduling. They
+ * do not imply the DMA mapping is valid.
+ *
+ * For now these also take/drop the active reference in lockstep with the
+ * software one -- see the ->active comment in struct dma_buf_io_map.
+ */
 static inline struct dma_buf_io_map *
 dma_buf_io_get_map(struct dma_buf_io_ctx *ctx)
 {
@@ -107,15 +175,21 @@ dma_buf_io_get_map(struct dma_buf_io_ctx *ctx)
 	guard(rcu)();
 
 	map = rcu_dereference(ctx->map);
-	if (unlikely(!map || !percpu_ref_tryget_live_rcu(&map->refs)))
+	if (unlikely(!map || !kref_get_unless_zero(&map->refs)))
+		return NULL;
+
+	if (unlikely(!dma_buf_io_map_active_tryget(map))) {
+		kref_put(&map->refs, __dma_buf_io_map_free);
 		return NULL;
+	}
 
 	return map;
 }
 
 static inline void dma_buf_io_map_drop(struct dma_buf_io_map *map)
 {
-	percpu_ref_put(&map->refs);
+	dma_buf_io_map_active_put(map);
+	kref_put(&map->refs, __dma_buf_io_map_free);
 }
 
 /*
